# --- secrets ---
.env
.env.*
!.env.example
!.env.test.example
*.pem
*.key
*_accessKeys.csv

# --- dependencies ---
node_modules/

# --- terraform ---
# infra/.gitignore already covers the real state and the real variables. These
# repeat the rules at the root, because the file that got committed was an
# empty state left behind by running terraform from the wrong directory, and
# a rule that only exists one level down does not catch that.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
.terraform.tfstate.lock.info

# --- build output ---
dist/
dist-lambda/
dist-demo/
build/
*.tsbuildinfo

# --- tests ---
coverage/

# --- logs ---
*.log
npm-debug.log*

# --- editors ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- notas personales ---
# El cuaderno de aprendizaje y la guía de estudio son para mí, no para el
# repositorio público.
NOTAS-DE-APRENDIZAJE.md
GUIA-DE-ESTUDIO.md
DESAFIOS-Y-ERRORES.md

# Donde caen los archivos que Claude manda al chat. Es una bandeja de entrada,
# no parte del proyecto, y adentro hay notas personales — las mismas que están
# ignoradas arriba. Un `git add -A` distraído las publicaría.
Claude outputs/

# --- os ---
.DS_Store
Thumbs.db
desktop.ini

# --- prisma ---
# migrations ARE committed — they are the schema's history.
# The generated client is not: it is rebuilt from the schema by `prisma generate`.
**/src/generated/
