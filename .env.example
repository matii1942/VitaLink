# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# To run the tests you also need .env.test — see .env.test.example. It points
# at a separate database, because the test suite empties every table.

# ---------------------------------------------------------------
# PostgreSQL — read by docker-compose.yml
# ---------------------------------------------------------------
POSTGRES_USER=vitalink
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=vitalink
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Prisma — must match the four values above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Host is localhost because Prisma runs on your machine, not inside
# the container. From another container it would be "postgres".
# ---------------------------------------------------------------
DATABASE_URL="postgresql://vitalink:change_me_locally@localhost:5432/vitalink?schema=public"

# ---------------------------------------------------------------
# API
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------
# Legacy SOAP simulator (Sprint 1)
# ---------------------------------------------------------------
LEGACY_SOAP_PORT=8080
LEGACY_SOAP_URL=http://localhost:8080/hospital?wsdl

# How big a hospital to simulate, and which one. The same seed always produces
# the same patients, wards and trajectories. Raise the patient count before
# measuring a query: on a table small enough to read whole, PostgreSQL ignores
# every index, quite correctly, and the plan you measure is not the plan you
# will run in production.
LEGACY_SIM_PATIENTS=25
LEGACY_SIM_SEED=42

# ---------------------------------------------------------------
# AWS (Sprint 4) — region only.
# Credentials come from `aws configure`, never from this file.
# Never put an access key here, not even temporarily.
# ---------------------------------------------------------------
AWS_REGION=us-east-2
S3_REPORTS_BUCKET=

# ---------------------------------------------------------------
# Language model (Sprint 5).
#
# Leave ANTHROPIC_API_KEY empty and the summary endpoint still answers: it
# reports state "unavailable" with the reason, and serves no generated text.
# Everything else — the fact sheet, the verification, the budget, the cache —
# is tested without it.
#
# The key belongs here and nowhere else. Never in the repository, never in a
# chat window, never in a Terraform variable file.
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# The self-imposed cap for a UTC calendar month. The gate refuses a call whose
# worst case would cross it, so the limit is respected before the money is
# spent rather than reported after.
LLM_MONTHLY_BUDGET_USD=5

# List price in United States dollars per million tokens, checked on
# 27 September 2026. These are settings, not constants, because the provider
# changes them and a stale price makes every budget decision quietly wrong.
LLM_INPUT_USD_PER_MTOK=1
LLM_OUTPUT_USD_PER_MTOK=5

# The ceiling on one answer. This is what makes the cost of a call knowable
# before making it.
LLM_MAX_OUTPUT_TOKENS=300

# How many rounds of observations go into a fact sheet. Six is about a day at
# the four-hourly rhythm of a general ward, and it is the biggest single lever
# on what a summary costs.
LLM_OBSERVATION_ROUNDS=6
