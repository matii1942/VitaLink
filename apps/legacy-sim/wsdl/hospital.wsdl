<?xml version="1.0" encoding="UTF-8"?>

<!--
  HospitalService 1.0 — Hospital Information System

  Read-only query interface for patients admitted to general wards.
  Access restricted to authorised systems.

  NOTE: dates are transmitted as strings in DD/MM/YYYY format.
  Boolean flags are transmitted as 'S' / 'N'.

  The simulated hospital is Argentinian, so the coded values it emits
  (AIRE, CANULA, GUARDIA, QUIROFANO, S/N) are in Spanish. Translating a
  legacy system's vocabulary is part of the integration work.
-->

<definitions name="HospitalService"
             targetNamespace="http://vitalink.local/hospital"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://vitalink.local/hospital"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

  <!-- ==================================================================
       1. TYPES — the data structures, described in XML Schema
       ================================================================== -->
  <types>
    <xsd:schema targetNamespace="http://vitalink.local/hospital"
                elementFormDefault="qualified">

      <!-- ========== Patient ========== -->
      <xsd:complexType name="Patient">
        <xsd:sequence>
          <xsd:element name="mrn"         type="xsd:string"/>
          <xsd:element name="nationalId"  type="xsd:string" nillable="true"/>
          <xsd:element name="familyName"  type="xsd:string"/>
          <xsd:element name="givenName"   type="xsd:string"/>
          <!-- DD/MM/YYYY -->
          <xsd:element name="birthDate"   type="xsd:string"/>
          <!-- M | F | 1 | 2 | U (two codings coexist after an unfinished migration) -->
          <xsd:element name="sexCode"     type="xsd:string"/>
          <!-- 1 = standard scale | 2 = target 88-92% (hypercapnic respiratory failure) -->
          <xsd:element name="news2Scale"  type="xsd:string" nillable="true"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- ========== Admission ========== -->
      <xsd:complexType name="Admission">
        <xsd:sequence>
          <xsd:element name="admissionId"    type="xsd:string"/>
          <xsd:element name="mrn"            type="xsd:string"/>
          <!-- DD/MM/YYYY HH:MM -->
          <xsd:element name="admittedAt"     type="xsd:string"/>
          <xsd:element name="dischargedAt"   type="xsd:string" nillable="true"/>
          <xsd:element name="ward"           type="xsd:string"/>
          <!-- URG (urgent) | PROG (scheduled) -->
          <xsd:element name="admissionType"  type="xsd:string"/>
          <!-- Spanish source codes: GUARDIA (A&E) | QUIROFANO (theatre) | HEMODINAMIA (cath lab) | DERIVACION (transfer) -->
          <xsd:element name="sourceUnit"     type="xsd:string" nillable="true"/>
          <xsd:element name="diagnosis"      type="xsd:string" nillable="true"/>
          <!-- S (yes) | N (no) -->
          <xsd:element name="firstAdmission" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="AdmissionList">
        <xsd:sequence>
          <xsd:element name="admission" type="tns:Admission"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- ========== Observation (vital signs) ========== -->
      <xsd:complexType name="Observation">
        <xsd:sequence>
          <xsd:element name="observationId"     type="xsd:string"/>
          <xsd:element name="admissionId"       type="xsd:string"/>
          <!-- DD/MM/YYYY HH:MM -->
          <xsd:element name="recordedAt"        type="xsd:string"/>
          <xsd:element name="respirationRate"   type="xsd:int"    nillable="true"/>
          <xsd:element name="oxygenSaturation"  type="xsd:int"    nillable="true"/>
          <!-- Spanish respiratory support codes: AIRE (room air) | CANULA (nasal cannula) | MASCARA (mask) | CPAP | VNI (NIV) | PSV -->
          <xsd:element name="respSupport"       type="xsd:string"/>
          <xsd:element name="systolicBP"        type="xsd:int"    nillable="true"/>
          <xsd:element name="pulse"             type="xsd:int"    nillable="true"/>
          <!-- ACVPU: A | C | V | P | U -->
          <xsd:element name="consciousness"     type="xsd:string"/>
          <!-- decimal written with a comma: 36,8 -->
          <xsd:element name="temperature"       type="xsd:string" nillable="true"/>
          <xsd:element name="recordedBy"        type="xsd:string" nillable="true"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="ObservationList">
        <xsd:sequence>
          <xsd:element name="observation" type="tns:Observation"
                       minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <!-- ========== Request and response elements ========== -->
      <xsd:element name="GetPatientRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="mrn" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetPatientResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="patient" type="tns:Patient"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ListAdmissionsRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="ward"       type="xsd:string" nillable="true"/>
            <!-- S = only admissions with no discharge date -->
            <xsd:element name="activeOnly" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ListAdmissionsResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="admissions" type="tns:AdmissionList"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetObservationsRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="admissionId" type="xsd:string"/>
            <!-- DD/MM/YYYY HH:MM — optional -->
            <xsd:element name="since"       type="xsd:string" nillable="true"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetObservationsResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="observations" type="tns:ObservationList"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </types>

  <!-- ==================================================================
       2. MESSAGE — what travels in each request and each response
       ================================================================== -->
  <message name="GetPatientInput">
    <part name="parameters" element="tns:GetPatientRequest"/>
  </message>
  <message name="GetPatientOutput">
    <part name="parameters" element="tns:GetPatientResponse"/>
  </message>

  <message name="ListAdmissionsInput">
    <part name="parameters" element="tns:ListAdmissionsRequest"/>
  </message>
  <message name="ListAdmissionsOutput">
    <part name="parameters" element="tns:ListAdmissionsResponse"/>
  </message>

  <message name="GetObservationsInput">
    <part name="parameters" element="tns:GetObservationsRequest"/>
  </message>
  <message name="GetObservationsOutput">
    <part name="parameters" element="tns:GetObservationsResponse"/>
  </message>

  <!-- ==================================================================
       3. PORTTYPE — the available operations
       ================================================================== -->
  <portType name="HospitalPortType">
    <operation name="GetPatient">
      <input  message="tns:GetPatientInput"/>
      <output message="tns:GetPatientOutput"/>
    </operation>
    <operation name="ListAdmissions">
      <input  message="tns:ListAdmissionsInput"/>
      <output message="tns:ListAdmissionsOutput"/>
    </operation>
    <operation name="GetObservations">
      <input  message="tns:GetObservationsInput"/>
      <output message="tns:GetObservationsOutput"/>
    </operation>
  </portType>

  <!-- ==================================================================
       4. BINDING — how it travels: SOAP 1.1 over HTTP, document/literal
       ================================================================== -->
  <binding name="HospitalBinding" type="tns:HospitalPortType">
    <soap:binding style="document"
                  transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="GetPatient">
      <soap:operation soapAction="http://vitalink.local/hospital/GetPatient"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>

    <operation name="ListAdmissions">
      <soap:operation soapAction="http://vitalink.local/hospital/ListAdmissions"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>

    <operation name="GetObservations">
      <soap:operation soapAction="http://vitalink.local/hospital/GetObservations"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <!-- ==================================================================
       5. SERVICE — the address it listens on
       ================================================================== -->
  <service name="HospitalService">
    <port name="HospitalPort" binding="tns:HospitalBinding">
      <soap:address location="http://localhost:8080/hospital"/>
    </port>
  </service>

</definitions>
